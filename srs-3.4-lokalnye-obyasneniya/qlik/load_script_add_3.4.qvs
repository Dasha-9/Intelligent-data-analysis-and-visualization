// СРС 3.4 · добавка к скрипту приложения практики 3.7 (IAVD_Assessment_v05.qvf)
// Вставить в конец скрипта загрузки (после FACT_DecisionLag) и нажать «Загрузить данные».
// 1) Смысловые группы полей: коррелированные признаки читаем группой (лекция 3.4, слайд 33).
//    Связь с FACT_Shap и DIM_Features – по source_column.
// 2) Переменные: срез SHAP для практики и порог в логарифме шансов.

ГруппыПолей:
LOAD * INLINE [
    source_column;ГруппаПоля
    Создан;время
    event_duration_s;время
    create_lag_s;время
    event_age_days;время
    len_src;сеть: адреса и хосты
    len_dst;сеть: адреса и хосты
    len_suser;текст алерта, команд и объектов
    len_duser;текст алерта, команд и объектов
    len_CMDLINE;текст алерта, команд и объектов
    len_Команда;текст алерта, команд и объектов
    len_commandName;текст алерта, команд и объектов
    len_processName;текст алерта, команд и объектов
    len_FilePath;текст алерта, команд и объектов
    len_FileName;текст алерта, команд и объектов
    len_objectLinks;текст алерта, команд и объектов
    len_Алерт;текст алерта, команд и объектов
    len_Значение Инцидента (группировка);текст алерта, команд и объектов
    len_Значение Атаки (группировка);текст алерта, команд и объектов
    n_rules;правило и источник
    is_business_hours;время
    is_night;время
    alert_chars;текст алерта, команд и объектов
    alert_words;текст алерта, команд и объектов
    cmd_chars;текст алерта, команд и объектов
    cmd_words;текст алерта, команд и объектов
    cmd_entropy;текст алерта, команд и объектов
    cmd_flags;текст алерта, команд и объектов
    cmd_has_url;текст алерта, команд и объектов
    cmd_has_b64;текст алерта, команд и объектов
    cmd_has_pipe;текст алерта, команд и объектов
    path_depth;текст алерта, команд и объектов
    path_in_temp;текст алерта, команд и объектов
    ip_count_src;сеть: адреса и хосты
    ip_count_dst;сеть: адреса и хосты
    src_is_private;сеть: адреса и хосты
    dst_is_private;сеть: адреса и хосты
    dst_external_count;сеть: адреса и хосты
    host_depth;сеть: адреса и хосты
    host_is_server;сеть: адреса и хосты
    has_suser;текст алерта, команд и объектов
    has_duser;текст алерта, команд и объектов
    has_malicious;текст алерта, команд и объектов
    freq_Наименование;правило и источник
    freq_Вендор;правило и источник
    CMDLINE;текст алерта, команд и объектов
    Команда;текст алерта, команд и объектов
    commandName;текст алерта, команд и объектов
    processName;текст алерта, команд и объектов
    Имя родителя процесса;текст алерта, команд и объектов
    Путь родителя процесса;текст алерта, команд и объектов
    ProcessPath;текст алерта, команд и объектов
    object.name;текст алерта, команд и объектов
    objectValue;текст алерта, команд и объектов
    objectLinks;текст алерта, команд и объектов
    suser;текст алерта, команд и объектов
    duser;текст алерта, команд и объектов
    Алерт;текст алерта, команд и объектов
    Наименование;правило и источник
    categoryMain;правило и источник
    categoryHigh;правило и источник
    categoryLow;правило и источник
    Пиктограмма IRP;правило и источник
    Критичность;правило и источник
    Критичность инцидента в источнике;правило и источник
    Источник инцидента;правило и источник
    Вендор из сием;правило и источник
