// Проект · дашборд дежурной смены SOC · скрипт загрузки (полный датасет iavd_incidents_raw_target.parquet)
// Вставить вместо всего, что ниже строк SET (строки SET в начале оставить). Подключение – lib://MyParquetFolder.
// Скрипт включает поля СРС 2.1–2.4, поэтому старые листы в том же приложении продолжают работать.

Tmp:
LOAD
    EntityId,
    Dual([Критичность],
         Match([Критичность],'Низкая','Средняя','Высокая','Критическая'))  as [Критичность],
    [Вердикт],
    If([Вердикт]='Не указан', 1, 0)                                         as [НетВердикта],
    [Количество инцидентов]                                                  as [Алертов],
    If(Len([Тип инцидента]) = 0, 'Не указан', [Тип инцидента])               as [Тип инцидента],
    src, dst, suser,
    If(Len([Правило корреляции SIEM]) = 0, 'Не указан',
       [Правило корреляции SIEM])                                            as [Правило корреляции SIEM],
    ConvertToLocalTime([Создан], 'GMT+03:00')                                as [СозданМСК],
    Date(Floor(ConvertToLocalTime([Создан], 'GMT+03:00')))                   as [ДатаСмены],
    Hour(ConvertToLocalTime([Создан], 'GMT+03:00'))                          as [ЧасМСК],
    If(Match([Вердикт],'Не указан','False Positive','Дубликат','Решён','Не решён') = 0,
       '· ' & [Вердикт],
       Pick(Match([Вердикт],'Не указан','False Positive','Дубликат','Решён','Не решён'),
            '○ нет', '● FP', '⊘ дубль', '✓ решён', '⊖ не решён'))           as [ВердиктЗнак],
    // СРС 2.4
    If([Вердикт] <> 'Не указан', 1, 0)                                      as [ЕстьВердикт],
    If([Вердикт] = 'False Positive', 1, 0)                                  as [ФлагFP],
    Timestamp(Floor(ConvertToLocalTime([Создан], 'GMT+03:00'), 1/24),
              'DD.MM.YYYY hh:00')                                           as [ЧасСлот],
    If([SLA просрочен (взятие в работу)] = 'True', 1,
       If([SLA просрочен (взятие в работу)] = 'False', 0))                  as [ПросрочкаSLA],
    If(Not IsNull([Дата взятия в работу]) and [Дата взятия в работу] >= [Создан],
       Round(([Дата взятия в работу] - [Создан]) * 1440, 0.01))             as [ВзятиеМин],
    [SLA по взятию в работу Атаки] / 60000                                  as [SLAвзятияМин],
    // дашборд смены
    [Фаза реагирования]                                                      as [Фаза],
    If(Index([Фаза реагирования], 'Закрыт') = 0, 1, 0)                      as [Открыта],
    [Hostname Цели]                                                          as [ЦелиСырые],
    Replace([Hostname атакующего], '~~||~~', ', ')                          as [Атакующий],
    SubField([Описание инцидента], '~~||~~', 1)                             as [Описание],
    [Ответственный],
    [Источник инцидента],
    TextBetween([Ссылка в NAD (actual)] & ' ', 'http', ' ')                 as [СсылкаNADхвост]
FROM [lib://MyParquetFolder/iavd_incidents_raw_target.parquet]
(parquet);

// «снимок» – последнее время создания карточки
MaxT:
LOAD Max([СозданМСК]) as MaxCreated Resident Tmp;
LET vSnap = Peek('MaxCreated', 0, 'MaxT');
DROP TABLE MaxT;

// нагрузка часа (СРС 2.4)
Left Join (Tmp)
LOAD [ЧасСлот], Count(EntityId) as [НагрузкаЧаса]
Resident Tmp
Group By [ЧасСлот];

// история вердиктов по правилу → «шумное» правило (≥ 300 разобранных карточек и ≥ 95 % FP)
RuleStats:
LOAD [Правило корреляции SIEM] as RuleKey, Count(EntityId) as RuleN, Sum([ФлагFP]) as RuleFP
Resident Tmp
Where [ЕстьВердикт] = 1 and [Правило корреляции SIEM] <> 'Не указан'
Group By [Правило корреляции SIEM];
NoisyMap:   Mapping LOAD RuleKey, If(RuleN >= 300 and RuleFP / RuleN >= 0.95, 1, 0) Resident RuleStats;
FPShareMap: Mapping LOAD RuleKey, RuleFP / RuleN Resident RuleStats;
DROP TABLE RuleStats;

Incidents:
NoConcatenate
LOAD *,
    If([ВозрастЧ] < 1,  Dual('< 1 ч', 1),
    If([ВозрастЧ] < 4,  Dual('1–4 ч', 2),
    If([ВозрастЧ] < 24, Dual('4–24 ч', 3),
    If([ВозрастЧ] < 72, Dual('1–3 сут', 4),
                        Dual('> 3 сут', 5)))))                              as [ВозрастОчереди],
    If([ВозрастЧ] < 24, Num([ВозрастЧ], '0,0') & ' ч',
                        Num(Floor([ВозрастЧ] / 24), '0') & ' сут')           as [Возраст];
LOAD *,
    If([НагрузкаЧаса] <= 5,   Dual('1–5', 1),
    If([НагрузкаЧаса] <= 10,  Dual('6–10', 2),
    If([НагрузкаЧаса] <= 20,  Dual('11–20', 3),
    If([НагрузкаЧаса] <= 50,  Dual('21–50', 4),
    If([НагрузкаЧаса] <= 100, Dual('51–100', 5),
                              Dual('> 100', 6))))))                         as [ГруппаНагрузки],
    If(Not IsNull([ВзятиеМин]), Log10([ВзятиеМин] + 0.1))                   as [ВзятиеLog10],
    If(Not IsNull([ВзятиеМин]), If([ВзятиеМин] > [SLAвзятияМин], 1, 0))      as [СверхSLA],
    ($(#vSnap) - [СозданМСК]) * 24                                          as [ВозрастЧ],
    If([СозданМСК] > $(#vSnap) - 1, 1, 0)                                   as [Последние24ч],
    ApplyMap('NoisyMap', [Правило корреляции SIEM], 0)                      as [ШумноеПравило],
    ApplyMap('FPShareMap', [Правило корреляции SIEM], Null())               as [ДоляFPправила],
    If(ApplyMap('NoisyMap', [Правило корреляции SIEM], 0) = 1, 'вероятный шум', '') as [Пометка],
    If([ПросрочкаSLA] = 1, 'просрочен', '')                                 as [SLA],
    If(Len([СсылкаNADхвост]) > 0, 'http' & [СсылкаNADхвост])                as [СсылкаNAD]
Resident Tmp;
DROP TABLE Tmp;
DROP FIELD [СсылкаNADхвост];

// цели карточки: «ip\fqdn\short|\fqdn\short» → по строке на цель (FQDN, иначе IP; 0.0.0.0 отбрасываем)
TgtRaw:
LOAD EntityId, SubField([ЦелиСырые], '|') as TgtEntry
Resident Incidents
Where Len([ЦелиСырые]) > 0;

Targets:
LOAD DISTINCT EntityId, [Цель]
Where Len([Цель]) > 0 and [Цель] <> '0.0.0.0';
LOAD EntityId,
     If(Len(SubField(TgtEntry, '\', 2)) > 0, SubField(TgtEntry, '\', 2), SubField(TgtEntry, '\', 1)) as [Цель]
Resident TgtRaw;
DROP TABLE TgtRaw;
DROP FIELD [ЦелиСырые];
