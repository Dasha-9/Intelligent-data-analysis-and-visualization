// Проект, часть 3 · дашборд «Можно ли верить объяснению модели?»
// Добавка к скрипту копии приложения практики 3.7 (IAVD_Assessment_v05.qvf → dashbord_shap.qvf).
// Вставить последней вкладкой, файл shap_values.csv положить в папку подключения RootIAVD (рядом с папкой data).
// shap_values.csv готовит python/prep_shap_flow.py + выгрузка из shap_flow.py: по одной строке на карточку эксплуатации.

ЗначенияПолей:
LOAD
    Text(EntityId)    AS EntityId,          // ключ к DIM_Cards
    ТипИнцидента,                           // Пиктограмма IRP: «Управление УЗ», «Сетевая безопасность» …
    Исход,                                  // TP / FN / FP / TN при τ = 0,019259; «без вердикта»
    ИсточникАдрес,                          // src_is_private: внешний / внутренний / не указан
    ПолеГруппировки,                        // «Значение Инцидента (группировка)»: пустое / заполнено
    ЧасСоздания,                            // час создания карточки, МСК
    Выходной,                               // выходной / будний
    ПравилоКарточки,                        // правило корреляции (Наименование)
    ОписаниеКратко                          // описание инцидента, первые 300 символов
FROM [lib://RootIAVD/shap_values.csv] (txt, utf8, embedded labels, delimiter is ';', msq);

SET vFlow = productive_20584;               // срез SHAP: поток эксплуатации
LET vZTau = Log(0.019259 / (1 - 0.019259)); // −3,9303: порог в логарифме шансов
