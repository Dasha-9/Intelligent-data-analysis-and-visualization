// СРС 2.4 · скрипт загрузки для проверки трёх EDA-гипотез (полный датасет iavd_incidents_raw_target.parquet)
// Вставить вместо строки LOAD * ... (строки SET в начале оставить)
// Подключение: lib://MyParquetFolder – папка, где лежит parquet
// Содержит и поля прошлых работ, поэтому листы СРС 2.1–2.3 в том же приложении продолжают работать

Tmp:
LOAD
    EntityId,
    Dual([Критичность],
         Match([Критичность],'Низкая','Средняя','Высокая','Критическая'))  as [Критичность],
    [Вердикт],
    If([Вердикт]='Не указан', 1, 0)                                         as [НетВердикта],
    [Количество инцидентов]                                                  as [Алертов],
    [Тип инцидента],
    src, dst, suser,
    [Правило корреляции SIEM],
    // поля прошлых работ (листы СРС 2.1–2.3)
    ConvertToLocalTime([Создан], 'GMT+03:00')                                as [СозданМСК],
    Date(Floor(ConvertToLocalTime([Создан], 'GMT+03:00')))                   as [ДатаСмены],
    Hour(ConvertToLocalTime([Создан], 'GMT+03:00'))                          as [ЧасМСК],
    If(Match([Вердикт],'Не указан','False Positive','Дубликат','Решён','Не решён') = 0,
       '· ' & [Вердикт],
       Pick(Match([Вердикт],'Не указан','False Positive','Дубликат','Решён','Не решён'),
            '○ нет', '● FP', '⊘ дубль', '✓ решён', '⊖ не решён'))           as [ВердиктЗнак],

    // Гипотеза 1: правило SIEM × доля False Positive (считаем только карточки с вердиктом)
    If([Вердикт] <> 'Не указан', 1, 0)                                      as [ЕстьВердикт],
    If([Вердикт] = 'False Positive', 1, 0)                                  as [ФлагFP],

    // Гипотеза 2: нагрузка часа × просрочка SLA взятия в работу
    Timestamp(Floor(ConvertToLocalTime([Создан], 'GMT+03:00'), 1/24),
              'DD.MM.YYYY hh:00')                                           as [ЧасСлот],
    If([SLA просрочен (взятие в работу)] = 'True', 1,
       If([SLA просрочен (взятие в работу)] = 'False', 0))                  as [ПросрочкаSLA],   // пусто -> NULL, в Avg не входит

    // Гипотеза 3: минуты до взятия в работу по критичности против SLA
    If(Not IsNull([Дата взятия в работу])
       and [Дата взятия в работу] >= [Создан],
       Round(([Дата взятия в работу] - [Создан]) * 1440, 0.01))             as [ВзятиеМин],      // пустые и отрицательные интервалы -> NULL
    [SLA по взятию в работу Атаки] / 60000                                  as [SLAвзятияМин]
FROM [lib://MyParquetFolder/iavd_incidents_raw_target.parquet]
(parquet);

// Сколько карточек создано в тот же час – «нагрузка часа»
Left Join (Tmp)
LOAD [ЧасСлот], Count(EntityId) as [НагрузкаЧаса]
Resident Tmp
Group By [ЧасСлот];

Incidents:
NoConcatenate
LOAD *,
    If([НагрузкаЧаса] <= 5,   Dual('1–5', 1),
    If([НагрузкаЧаса] <= 10,  Dual('6–10', 2),
    If([НагрузкаЧаса] <= 20,  Dual('11–20', 3),
    If([НагрузкаЧаса] <= 50,  Dual('21–50', 4),
    If([НагрузкаЧаса] <= 100, Dual('51–100', 5),
                              Dual('> 100', 6))))))                         as [ГруппаНагрузки],
    If(Not IsNull([ВзятиеМин]), Log10([ВзятиеМин] + 0.1))                   as [ВзятиеLog10],
    If(Not IsNull([ВзятиеМин]), If([ВзятиеМин] > [SLAвзятияМин], 1, 0))      as [СверхSLA]
Resident Tmp;
Drop Table Tmp;
